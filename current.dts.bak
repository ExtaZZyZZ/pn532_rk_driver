				phandle = <0x8d>;
			};
		};
	};

	vcc1v8-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "1v8_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x25>;
		phandle = <0x60>;
	};

	vcc3v3-pcie20-pwr-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "3v3_pcie20";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		startup-delay-us = <0x4e20>;
		vin-supply = <0x25>;
		status = "disabled";
		phandle = <0x6f>;
	};

	vcc3v3-pcie30-regulator {
		pinctrl-names = "default";
		pinctrl-0 = <0x113>;
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x99 0x1d 0x00>;
		regulator-name = "3v3_pcie30";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		startup-delay-us = <0x4e20>;
		vin-supply = <0x9a>;
		phandle = <0x115>;
	};

	vcc3v3-pi6c-regulator {
		pinctrl-names = "default";
		pinctrl-0 = <0x114>;
		compatible = "regulator-fixed";
		regulator-boot-on;
		gpio = <0x99 0x1c 0x01>;
		regulator-name = "3v3_pi6c";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		startup-delay-us = <0x4e20>;
		vin-supply = <0x115>;
		phandle = <0xe5>;
