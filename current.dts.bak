	vcc5v0-usb3-host1-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "vcc5v0_usb3_host1";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		startup-delay-us = <0x4e20>;
		vin-supply = <0x9a>;
		status = "disabled";
		phandle = <0xd8>;
	};

	vcc5v0-usb3-otg0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb3_otg0";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		startup-delay-us = <0x4e20>;
		vin-supply = <0x9a>;
		status = "disabled";
		phandle = <0x8a>;
	};

	vcc-cam0-regulator {
		pinctrl-names = "default";
		pinctrl-0 = <0x116>;
		compatible = "regulator-fixed";
		regulator-boot-on;
		enable-active-high;
		gpio = <0xf4 0x1a 0x00>;
		regulator-name = "vcc_cam0";
		startup-delay-us = <0x3d090>;
		status = "disabled";
		phandle = <0x93>;
	};

	vcc-cam1-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "vcc_cam1";
		startup-delay-us = <0x3d090>;
		status = "disabled";
		phandle = <0x2c3>;
	};

